# Копирайте този файл като .env и попълнете стойностите.
# .env не се качва в GitHub (виж .gitignore).
#
# Тук стоят само тайните и стойностите, нужни при стартиране.
# Правилата на играта, цените и асистентът се настройват от Django admin.

# ---------- Основно API (Django) ----------
DJANGO_SECRET_KEY=сменете-ме-с-дълъг-случаен-низ
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_HOST=127.0.0.1
DJANGO_PORT=8000

# Само за публикуваната версия (DJANGO_DEBUG=False):
# адресът на сайта, напр. https://questboard.example.bg
DJANGO_CSRF_TRUSTED_ORIGINS=
# True, ако пред приложението има прокси сървър с HTTPS (nginx, хостинг)
DJANGO_BEHIND_PROXY=False
# True – пренасочва HTTP към HTTPS; HSTS в секунди (0 = изключено, напр. 31536000 = година)
DJANGO_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

# База данни: sqlite (за разработка) или mysql
DB_ENGINE=sqlite
DB_NAME=questboard
DB_USER=questboard
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Парола за тестовите акаунти от „python manage.py seed_demo“ (поне 8 символа)
DEMO_PASSWORD=

# ---------- Услуга на асистента (FastAPI) ----------
ASSISTANT_PORT=8001
ASSISTANT_URL=http://127.0.0.1:8001
# Общ таен ключ между Django и асистента. Без него асистентът отказва всяка заявка.
ASSISTANT_TOKEN=сменете-ме-с-друг-дълъг-случаен-низ

# Ключове за езиковите модели – попълва се само този, който ползвате.
# Кой доставчик и модел се ползват, се избира от Django admin.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
